{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Common cmake vars",
            "hidden": true,
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "CPACK_GENERATOR": "RPM",
                "BUILD_SHARED_LIBS": "ON",
                "UNIT_TESTS": "ON",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "1"
            }
        },
        {
            "name": "release",
            "displayName": "Release (default)",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TEST_COVERAGE": "ON",
                "SANITIZE_ADDRESS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "Debug",
            "description": "Debug build preset",
            "displayName": "Debug",
            "configurePreset": "debug",
            "jobs": 24
        },
        {
            "name": "Release",
            "description": "Release build preset",
            "displayName": "Release",
            "configurePreset": "release",
            "jobs": 24
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}